#!/bin/sh
# VPN-Beryl local control panel API (session auth, password-only, brute-force).
# Auth: validates against /etc/shadow root  == GL.iNet admin pass (rpcd $p$root). Unified.
SESSDIR=/tmp/lk-sess; BFDIR=/tmp/lk-bf
mkdir -p "$SESSDIR" "$BFDIR" 2>/dev/null
MAXFAIL=5; LOCKSEC=60; SESSTTL=86400
API=http://127.0.0.1:9090; PU=/etc/sing-box/postup.sh

emit(){ printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n'; [ -n "$1" ] && printf 'Set-Cookie: sid=%s; Path=/; HttpOnly; SameSite=Strict; Max-Age=86400\r\n' "$1"; printf '\r\n'; }
SID=$(printf '%s' "$HTTP_COOKIE" | sed -n 's/.*sid=\([A-Za-z0-9]\{8,\}\).*/\1/p')
valid(){ [ -n "$SID" ] && [ -f "$SESSDIR/$SID" ] && [ "$(date +%s)" -lt "$(cat "$SESSDIR/$SID" 2>/dev/null || echo 0)" ]; }
check_pw(){ S=$(grep '^root:' /etc/shadow | cut -d: -f2); A=$(printf '%s' "$S" | cut -d'$' -f2); SA=$(printf '%s' "$S" | cut -d'$' -f3); case "$A" in 1) F=-1;; 5) F=-5;; 6) F=-6;; apr1) F=-apr1;; *) F=-5;; esac; [ -n "$SA" ] && [ "$(openssl passwd $F -salt "$SA" "$1" 2>/dev/null)" = "$S" ]; }
now_of(){ curl -s --max-time 3 "$API/proxies/$1" 2>/dev/null | sed -n 's/.*"now": *"\([A-Za-z0-9._-]*\)".*/\1/p'; }
# killswitch backend (fw4/nftables vs fw3/iptables) + desired-state live in ks-lib.sh
. /etc/sing-box/ks-lib.sh 2>/dev/null
ks_on(){ ks_set_desired 1; ks_enforce; }
ks_off(){ ks_set_desired 0; ks_enforce; }

ACT=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*action=\([a-z_]*\).*/\1/p')
IP=$(printf '%s' "${REMOTE_ADDR:-x}" | tr -c 'A-Za-z0-9.' '_'); BF="$BFDIR/$IP"
N=$(date +%s)

if [ "$ACT" = "login" ]; then
  if [ -f "$BF" ]; then read F L < "$BF"; else F=0; L=0; fi
  if [ "$N" -lt "${L:-0}" ]; then emit; echo "{\"ok\":false,\"locked\":true,\"wait\":$((L-N))}"; exit 0; fi
  PW=$(head -c "${CONTENT_LENGTH:-0}" 2>/dev/null)
  if [ -n "$PW" ] && check_pw "$PW"; then
    rm -f "$BF"; T=$(openssl rand -hex 16); echo "$((N+SESSTTL))" > "$SESSDIR/$T"
    emit "$T"; echo '{"ok":true}'
  else
    F=$((F+1)); NL=0; if [ "$F" -ge "$MAXFAIL" ]; then NL=$((N+LOCKSEC)); F=0; fi
    echo "$F $NL" > "$BF"; emit
    if [ "$NL" -gt 0 ]; then echo "{\"ok\":false,\"locked\":true,\"wait\":$LOCKSEC}"; else echo '{"ok":false,"locked":false}'; fi
  fi
  exit 0
fi

if ! valid; then emit; echo '{"auth":false}'; exit 0; fi

case "$ACT" in
  logout) rm -f "$SESSDIR/$SID"; emit; echo '{"ok":true}'; exit 0;;
  vpn_on) echo 1 > /etc/sing-box/vpn.enabled; /etc/init.d/sing-box start >/dev/null 2>&1; sleep 1; [ -f "$PU" ] && sh "$PU" >/dev/null 2>&1; ks_enforce 2>/dev/null; (/etc/sing-box/geo-refresh.sh &) 2>/dev/null;;
  speedtest)
    DB=$(curl -4 -s --max-time 12 -o /dev/null -w '%{speed_download}' 'https://speed.cloudflare.com/__down?bytes=30000000' 2>/dev/null)
    UB=$(head -c 8000000 /dev/zero 2>/dev/null | curl -4 -s --max-time 12 -o /dev/null -w '%{speed_upload}' --data-binary @- 'https://speed.cloudflare.com/__up' 2>/dev/null)
    DM=$(awk "BEGIN{printf \"%.1f\", ${DB:-0}*8/1000000}")
    UM=$(awk "BEGIN{printf \"%.1f\", ${UB:-0}*8/1000000}")
    emit; echo "{\"down\":\"$DM\",\"up\":\"$UM\"}"; exit 0;;
  vpn_off) echo 0 > /etc/sing-box/vpn.enabled; /etc/init.d/sing-box stop >/dev/null 2>&1; killall sing-box >/dev/null 2>&1; ip rule del pref 500 >/dev/null 2>&1; ks_enforce 2>/dev/null; (sleep 3; /etc/sing-box/geo-refresh.sh &) 2>/dev/null;;
  ks_on) ks_on;;
  ks_off) ks_off;;
  proto) P=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*[?&]p=\([A-Za-z0-9._-]*\).*/\1/p')
      # Selectable outbounds: "auto" (all servers), the protocol-filtered "auto-reality"
      # / "auto-hy2" groups (rebuild.sh builds them only when servers of that family
      # exist), or a real server tag. Anything else (legacy phantoms hy2-out/reality-out)
      # has no matching outbound -> coerce to "auto" so a bad pick can never blackhole
      # traffic / kill the LAN with killswitch on.
      case "$P" in
        auto) ;;
        auto-reality|auto-hy2) grep -q "\"tag\": \"$P\"" /etc/sing-box/reality_full.json 2>/dev/null || P=auto ;;
        *) { [ -n "$P" ] && [ -f "/etc/sing-box/servers/$P.json" ]; } || P=auto ;;
      esac
      curl -s --max-time 4 -X PUT "$API/proxies/select" -d "{\"name\":\"$P\"}" >/dev/null 2>&1; (sleep 2; /etc/sing-box/geo-refresh.sh &) 2>/dev/null;;
  setpass) NP=$(head -c "${CONTENT_LENGTH:-0}" 2>/dev/null)
    if [ -n "$NP" ] && [ "${#NP}" -ge 6 ]; then printf 'root:%s\n' "$NP" | chpasswd >/dev/null 2>&1; emit; echo '{"ok":true,"msg":"Password changed"}'; else emit; echo '{"ok":false,"msg":"At least 6 characters"}'; fi
    exit 0;;
  ip) /etc/sing-box/geo-refresh.sh 2>/dev/null
      G=$(cat /tmp/lk-geo 2>/dev/null)
      EG=$(printf '%s' "$G"|cut -d'|' -f2); CO=$(printf '%s' "$G"|cut -d'|' -f3); CI=$(printf '%s' "$G"|cut -d'|' -f4); PG=$(printf '%s' "$G"|cut -d'|' -f5)
      emit; echo "{\"egress\":\"$EG\",\"country\":\"$CO\",\"city\":\"$CI\",\"ping\":\"$PG\"}"; exit 0;;
  addserver)
      NM=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*[?&]name=\([A-Za-z0-9._-]*\).*/\1/p')
      LINK=$(head -c "${CONTENT_LENGTH:-0}" 2>/dev/null)
      TAG="srv-$(date +%s)"; [ -n "$NM" ] && TAG="srv-$(printf '%s' "$NM" | tr -c 'A-Za-z0-9._-' '_')"
      OUT=$(/etc/sing-box/parse-link.sh "$LINK" "$TAG" 2>/tmp/parse-perr)
      if [ -z "$OUT" ]; then REASON=$(cat /tmp/parse-perr 2>/dev/null | sed 's/"/\\"/g'); emit; echo "{\"ok\":false,\"msg\":\"Bad link: ${REASON:-unrecognized}\"}"; exit 0; fi
      printf '%s' "$OUT" > "/etc/sing-box/servers/$TAG.json"
      R=$(/etc/sing-box/rebuild.sh 2>/dev/null | head -1)
      if [ "$R" = "OK" ]; then emit; echo "{\"ok\":true,\"tag\":\"$TAG\"}"; else rm -f "/etc/sing-box/servers/$TAG.json"; /etc/sing-box/rebuild.sh >/dev/null 2>&1; emit; echo '{"ok":false,"msg":"Server config rejected"}'; fi
      exit 0;;
  importservers)
      # Bulk import (Shadowrocket-style): POST body = many share-links (one per line),
      # a base64 subscription blob, or an http(s):// subscription URL. import-links.sh
      # parses each + rebuilds once, prints {"ok":..,"added":N,"failed":M,"tags":[...]}.
      BODY=$(head -c "${CONTENT_LENGTH:-0}" 2>/dev/null)
      OUT=$(printf '%s' "$BODY" | /etc/sing-box/import-links.sh 2>/dev/null)
      (sleep 2; /etc/sing-box/geo-refresh.sh &) 2>/dev/null
      emit; printf '%s\n' "${OUT:-{\"ok\":false,\"msg\":\"import failed\"}}"; exit 0;;
  listservers)
      L=""; for f in /etc/sing-box/servers/*.json; do [ -f "$f" ] || continue; t=$(basename "$f" .json); ty=$(sed -n 's/.*"type": *"\([a-z0-9]*\)".*/\1/p' "$f"|head -1); sv=$(sed -n 's/.*"server": *"\([^"]*\)".*/\1/p' "$f"|head -1); L="$L,{\"tag\":\"$t\",\"type\":\"$ty\",\"server\":\"$sv\"}"; done
      emit; echo "{\"servers\":[${L#,}]}"; exit 0;;
  delserver)
      # Accept ANY safe tag (not only srv-*). Legacy servers added by older add-server.sh
      # have no srv- prefix (e.g. VPS-HY2) and were previously undeletable. The [ -f ]
      # guard + charset (no slash) keep this safe from traversal.
      DP=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*[?&]p=\([A-Za-z0-9._-]*\).*/\1/p')
      [ -n "$DP" ] && [ -f "/etc/sing-box/servers/$DP.json" ] && { rm -f "/etc/sing-box/servers/$DP.json"; /etc/sing-box/rebuild.sh >/dev/null 2>&1; }
      emit; echo '{"ok":true}'; exit 0;;
  checkupdate)
      INST=$(cat /etc/sing-box/version 2>/dev/null | tr -d ' \r\n'); [ -n "$INST" ] || INST=unknown
      LAT=$(curl -fsSL --max-time 8 https://raw.githubusercontent.com/mxt96/reality-vpn-glinet-universal/main/VERSION 2>/dev/null | tr -d ' \r\n'); [ -n "$LAT" ] || LAT=unknown
      UPD=false; [ "$LAT" != unknown ] && [ "$INST" != "$LAT" ] && UPD=true
      emit; echo "{\"installed\":\"$INST\",\"latest\":\"$LAT\",\"update\":$UPD}"; exit 0;;
  update)
      # The update re-runs the installer, which restarts services — so it must NOT
      # run inside uhttpd's process tree (it would be killed, and routers here have
      # no setsid/start-stop-daemon). Detach via the router's own cron, which is an
      # independent process. A one-shot, self-removing, lock-guarded cron line.
      cat > /tmp/sb-update.sh <<'UPD'
#!/bin/sh
[ -f /tmp/sb-update.running ] && exit 0
touch /tmp/sb-update.running
cd /tmp && rm -rf reality-vpn-glinet-universal-main \
  && curl -fsSL https://github.com/mxt96/reality-vpn-glinet-universal/archive/refs/heads/main.tar.gz | tar xz \
  && cd reality-vpn-glinet-universal-main && sh install.sh
sed -i '\#/tmp/sb-update.sh#d' /etc/crontabs/root 2>/dev/null
/etc/init.d/cron restart 2>/dev/null
rm -f /tmp/sb-update.running
UPD
      chmod +x /tmp/sb-update.sh
      touch /etc/crontabs/root
      grep -q '/tmp/sb-update.sh' /etc/crontabs/root 2>/dev/null || echo '* * * * * /bin/sh /tmp/sb-update.sh' >> /etc/crontabs/root
      /etc/init.d/cron enable >/dev/null 2>&1; /etc/init.d/cron restart >/dev/null 2>&1
      emit; echo "{\"ok\":true,\"msg\":\"Update scheduled — installs within ~1-2 min, page reloads\"}"; exit 0;;
  status) :;;
esac
# toggle reflects DESIRED state (sticky through auto-reconnect); egress/ping below
# convey the live connection. KS reflects user intent (held even while VPN is off).
VPN=$(vpn_desired && echo true || echo false)
KS=$(ks_desired && echo true || echo false)
MODE=$(now_of select); ACTIVE="$MODE"; [ "$MODE" = "auto" ] && ACTIVE=$(now_of auto)
G=$(cat /tmp/lk-geo 2>/dev/null); EG=$(printf '%s' "$G"|cut -d'|' -f2); CO=$(printf '%s' "$G"|cut -d'|' -f3); CI=$(printf '%s' "$G"|cut -d'|' -f4); PG=$(printf '%s' "$G"|cut -d'|' -f5)
[ -z "$G" ] && (/etc/sing-box/geo-refresh.sh &) 2>/dev/null
SRV="—"
[ -n "$ACTIVE" ] && [ "$ACTIVE" != "direct" ] && [ -f "/etc/sing-box/servers/$ACTIVE.json" ] && SRV=$(sed -n 's/.*"server": *"\([^"]*\)".*/\1/p' "/etc/sing-box/servers/$ACTIVE.json" | head -1)
[ -z "$SRV" ] && SRV="—"
VER=$(cat /etc/sing-box/version 2>/dev/null | tr -d ' \r\n'); [ -n "$VER" ] || VER="—"
# "updated_to" set right after an install (Update button) and expires in 10 min,
# so the panel can show a one-shot "✅ updated to vX" confirmation.
UPDTO=""; [ -n "$(find /etc/sing-box/.updated_to -mmin -10 2>/dev/null)" ] && UPDTO=$(cat /etc/sing-box/.updated_to 2>/dev/null | tr -d ' \r\n')
emit; echo "{\"auth\":true,\"vpn\":$VPN,\"killswitch\":$KS,\"mode\":\"$MODE\",\"active\":\"$ACTIVE\",\"server\":\"$SRV\",\"egress\":\"$EG\",\"country\":\"$CO\",\"city\":\"$CI\",\"ping\":\"$PG\",\"version\":\"$VER\",\"updated_to\":\"$UPDTO\"}"
