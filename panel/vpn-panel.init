#!/bin/sh /etc/rc.common
START=98
USE_PROCD=1
start_service(){
  local lan_ip
  lan_ip=$(uci -q get network.lan.ipaddr | cut -d/ -f1)
  case "$lan_ip" in ''|*[!0-9.]*) logger -t vpn-panel 'LAN IPv4 address unavailable'; return 1 ;; esac
  procd_open_instance
  procd_set_param command /usr/sbin/uhttpd -f -h /www-vpn -x /cgi-bin -p 127.0.0.1:8088 -p "$lan_ip:8088"
  procd_set_param respawn
  procd_close_instance
}
service_triggers(){
  procd_add_interface_trigger 'interface.*' 'lan' /etc/init.d/vpn-panel restart
}
